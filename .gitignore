# ---- macOS ---------------------------------------------------------
.DS_Store
Icon?

# ---- Local PHP -----------------------------------------------------
# Written by the atomic saves in admin/inc/*.php if a save is
# interrupted; never wanted in the repository.
*.tmp

# ---- Deleted-file backups ------------------------------------------
# Removing a photo or an attachment moves the file here rather than
# erasing it. That is a safety net on the live server, not history
# worth carrying in the repository.
/storage/backups/
/admin/storage/backups/

# ---- Large archives ------------------------------------------------
# Zipping the whole site into the repository pushed single files over
# GitHub's 100MB limit and broke the push.
/assets.zip
/admin.zip
assets/images/completed-projects.zip
