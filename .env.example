# ---------------------------------------------------------------------
# Ceylon Energy Services — backend configuration
#
# HOW TO USE THIS FILE
#   1. Copy it:  cp .env.example .env
#   2. Fill in the real values below.
#   3. Never commit .env — it is already listed in .gitignore.
#
# Putting this on cPanel instead of your laptop? See DEPLOY-CPANEL.md —
# the settings get split across TWO .env files there, and the admin
# panel only needs two of the values below.
#
# This file (.env.example) is safe to commit: it contains placeholders
# only, so a new developer can see WHICH settings are needed without
# ever seeing the actual passwords.
# ---------------------------------------------------------------------

# ---- Server ---------------------------------------------------------
# Port the API listens on. Most hosts set this for you.
#
# Deliberately NOT 5000: on macOS, the built-in AirPlay Receiver holds
# port 5000 and answers every request with "403 Forbidden". The symptom
# is baffling — "npm start" reports it is listening, but the admin panel
# says the backend is down and every upload fails with a 403 that never
# reached your code. Any free port avoids it; 5050 is the default here.
PORT=5050

# "development" shows full error messages; "production" hides them.
NODE_ENV=development

# Websites allowed to call this API from a browser, comma-separated.
# Use the exact origin, with protocol and no trailing slash.
# During local development "*" is fine; set real domains in production.
ALLOWED_ORIGINS=http://localhost:8000,https://ceylonenergyservices.com,https://www.ceylonenergyservices.com


# ---- MongoDB Atlas --------------------------------------------------
# Atlas -> your cluster -> Connect -> Drivers -> copy the connection string,
# then replace <db_password> with your real database-user password.
#
# If the password contains any of  @ : / ? # [ ] %  it must be
# percent-encoded (e.g. "p@ss" becomes "p%40ss"), or the driver will read
# the string wrong and fail to connect.
MONGODB_URI=mongodb+srv://YOUR_DB_USER:YOUR_DB_PASSWORD@yourcluster.xxxxx.mongodb.net/?retryWrites=true&w=majority&appName=ceyloneenergy

# Which database inside the cluster to use. Created automatically on first write.
MONGODB_DB_NAME=ceylonenergy


# ---- Cloudinary -----------------------------------------------------
# Cloudinary Console -> Settings -> API Keys.
# CLOUDINARY_CLOUD_NAME is shown at the top of that page as "Cloud name".
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Folder inside your Cloudinary media library where project photos go.
CLOUDINARY_FOLDER=ceylon-energy/completed-projects


# ---- Admin panel ----------------------------------------------------
# Where the PHP admin panel (admin/projects.php) should send uploads and
# deletions. This is the address of the Node backend above.
#
# On a live server this is the ONLY setting that decides whether the
# Projects page works — Attachments and Awards never use it, which is why
# they keep working while Projects shows a red banner.
#
#   Local development:   http://localhost:5050        (must match PORT above)
#   cPanel subdomain:    https://api.yourdomain.com
#   cPanel subfolder:    https://yourdomain.com/ceylon-api
#   Render / other host: https://your-app.onrender.com
#
# Two rules, both of which produce a 404 when broken:
#   - No trailing slash.
#   - No "/api" on the end. The panel adds /api/health, /api/projects and
#     the rest by itself, so ".../api" becomes ".../api/api/health".
#
# The subfolder form only works once cPanel has actually published the app
# at that folder (Setup Node.js App -> Application URL -> SAVE). Until then
# the web server answers 404 for it by itself and never reaches Node.
# admin/check-env.php tells you which of those two you are looking at.
GALLERY_API_BASE=http://localhost:5050


# ---- Admin API token ------------------------------------------------
# A long random secret the admin panel sends when uploading or deleting.
# Anyone holding this can change the gallery, so treat it like a password.
#
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=replace_with_a_long_random_string
